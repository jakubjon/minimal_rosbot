<sdf version='1.9'>
  <model name='diffbot'>

    <!-- Base footprint: chassis + lidar lumped (fixed joints collapsed) -->
    <link name='base_footprint'>
      <inertial>
        <pose>0.005 0 0.10375 0 0 0</pose>
        <mass>5.3</mass>
        <inertia>
          <ixx>0.046</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.115</iyy>
          <iyz>0</iyz>
          <izz>0.132</izz>
        </inertia>
      </inertial>

      <!-- Chassis collision -->
      <collision name='chassis_collision'>
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.50 0.30 0.10</size>
          </box>
        </geometry>
      </collision>

      <!-- Caster collision -->
      <collision name='caster_collision'>
        <pose>-0.225 0 0.025 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.001</mu>
              <mu2>0.001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Lidar collision -->
      <collision name='lidar_collision'>
        <pose>0.15 0 0.20 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.05</length>
            <radius>0.03</radius>
          </cylinder>
        </geometry>
      </collision>

      <!-- Chassis visual -->
      <visual name='chassis_visual'>
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.50 0.30 0.10</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <ambient>0.75 0.75 0.75 1</ambient>
        </material>
      </visual>

      <!-- Caster visual -->
      <visual name='caster_visual'>
        <pose>-0.225 0 0.025 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <ambient>0.3 0.3 0.3 1</ambient>
        </material>
      </visual>

      <!-- Lidar visual -->
      <visual name='lidar_visual'>
        <pose>0.15 0 0.20 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.05</length>
            <radius>0.03</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.25 0.25 0.25 1</diffuse>
          <ambient>0.25 0.25 0.25 1</ambient>
        </material>
      </visual>

      <!-- Lidar sensor -->
      <sensor name='ouster' type='gpu_lidar'>
        <topic>/diffbot/ouster/points</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>20</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <visualize>true</visualize>
        <pose>0.15 0 0.20 0 0 0</pose>
        <alwaysOn>1</alwaysOn>
      </sensor>
    </link>

    <!-- Left wheel -->
    <joint name='left_wheel_joint' type='revolute'>
      <pose relative_to='base_footprint'>0.05 0.15 0.05 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <link name='left_wheel_link'>
      <pose relative_to='left_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00034375</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000625</iyy>
          <iyz>0</iyz>
          <izz>0.00034375</izz>
        </inertia>
      </inertial>
      <collision name='left_wheel_collision'>
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.03</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='left_wheel_visual'>
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.03</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.125 0.125 0.125 1</diffuse>
          <ambient>0.125 0.125 0.125 1</ambient>
        </material>
      </visual>
    </link>

    <!-- Right wheel -->
    <joint name='right_wheel_joint' type='revolute'>
      <pose relative_to='base_footprint'>0.05 -0.15 0.05 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <link name='right_wheel_link'>
      <pose relative_to='right_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00034375</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000625</iyy>
          <iyz>0</iyz>
          <izz>0.00034375</izz>
        </inertia>
      </inertial>
      <collision name='right_wheel_collision'>
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.03</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='right_wheel_visual'>
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.03</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.125 0.125 0.125 1</diffuse>
          <ambient>0.125 0.125 0.125 1</ambient>
        </material>
      </visual>
    </link>

    <!-- Diff Drive plugin -->
    <plugin name='gz::sim::systems::DiffDrive' filename='ignition-gazebo-diff-drive-system'>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.30</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <max_linear_acceleration>3</max_linear_acceleration>
      <min_linear_acceleration>-3</min_linear_acceleration>
      <max_angular_acceleration>5</max_angular_acceleration>
      <min_angular_acceleration>-5</min_angular_acceleration>
      <max_linear_velocity>2</max_linear_velocity>
      <min_linear_velocity>-2</min_linear_velocity>
    </plugin>

    <plugin name='gz::sim::systems::JointStatePublisher' filename='ignition-gazebo-joint-state-publisher-system'/>

    <plugin name='ignition::gazebo::systems::OdometryPublisher' filename='ignition-gazebo-odometry-publisher-system'>
      <dimensions>3</dimensions>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Named frames for RSP compatibility -->
    <frame name='lidar_joint' attached_to='base_link'>
      <pose>0.15 0 0.10 0 0 0</pose>
    </frame>
    <frame name='lidar_link' attached_to='lidar_joint'/>
    <frame name='caster_joint' attached_to='base_link'>
      <pose>-0.225 0 -0.025 0 0 0</pose>
    </frame>
    <frame name='caster_link' attached_to='caster_joint'/>
    <frame name='base_footprint_joint' attached_to='base_footprint'>
      <pose>0 0 0.10 0 0 0</pose>
    </frame>
    <frame name='base_link' attached_to='base_footprint_joint'/>

  </model>
</sdf>
