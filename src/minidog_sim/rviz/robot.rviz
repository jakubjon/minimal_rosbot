Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.2
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
    # ── Robot ──────────────────────────────────────────────
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Class: rviz_default_plugins/RobotModel
          Description Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /robot_description
          Enabled: true
          Name: RobotModel
          TF Prefix: ""
          Update Interval: 0
          Visual Enabled: true
          Collision Enabled: false
        - Class: rviz_default_plugins/TF
          Enabled: true
          Frame Timeout: 15
          Marker Scale: 0.5
          Name: TF
          Show Arrows: true
          Show Axes: true
          Show Names: false
        - Class: rviz_default_plugins/Odometry
          Enabled: false
          Name: Odometry
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odom
          Keep: 100
          Shape:
            Alpha: 0.5
            Color: 0; 255; 0
            Head Length: 0.05
            Head Radius: 0.03
            Shaft Length: 0.10
            Shaft Radius: 0.015
            Value: Arrow
          Angle Tolerance: 0.1
          Position Tolerance: 0.1
      Enabled: true
      Name: Robot
    # ── Sensors ────────────────────────────────────────────
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Class: rviz_default_plugins/LaserScan
          Color: 255; 255; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: LaserScan
          Size (m): 0.02
          Style: Boxes
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /scan
          Use Fixed Frame: true
      Enabled: true
      Name: Sensors
    # ── Navigation ─────────────────────────────────────────
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.7
          Class: rviz_default_plugins/Map
          Color Scheme: map
          Draw Behind: true
          Enabled: true
          Name: Map
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /map
        - Alpha: 0.7
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: true
          Name: LocalCostmap
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_costmap/costmap
        - Alpha: 0.2
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: true
          Name: GlobalCostmap
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /global_costmap/costmap
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 206; 92; 0
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Line Style: Billboards
          Line Width: 0.03
          Name: GlobalPlan
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /plan
        - Alpha: 1
          Buffer Length: 5
          Class: rviz_default_plugins/Path
          Color: 138; 226; 52
          Enabled: true
          Head Diameter: 0.15
          Head Length: 0.1
          Line Style: Billboards
          Line Width: 0.02
          Name: LocalPlan
          Offset:
            X: 0
            Y: 0
            Z: 1
          Pose Color: 78; 154; 6
          Shaft Diameter: 0.05
          Shaft Length: 0.5
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /local_plan
        - Alpha: 1
          Class: rviz_default_plugins/Pose
          Color: 115; 210; 22
          Enabled: true
          Head Length: 0.3
          Head Radius: 0.1
          Name: Nav2Goal
          Shaft Length: 1
          Shaft Radius: 0.05
          Shape: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /goal_pose
        - Alpha: 1
          Class: rviz_default_plugins/Polygon
          Color: 25; 255; 0
          Enabled: true
          Name: LocalFootprint
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_costmap/published_footprint
      Enabled: true
      Name: Navigation
  Enabled: true
  Global Options:
    Background Color: 61; 56; 70
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/TopDownOrtho
    Scale: 40
    X: 0
    Y: 0
Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50
